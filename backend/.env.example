# Banco de dados PostgreSQL (Neon, Render, Supabase, local...)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/devvoluntario?sslmode=require"

# Servidor (em produção o Render define PORT sozinho)
PORT=3333
NODE_ENV=development

# Segredo do JWT: use um valor longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"

# Origens permitidas no CORS (separe várias por vírgula).
# Em produção: a URL do front-end, sem barra no final. Ex.: https://seu-app.vercel.app
CORS_ORIGIN="http://localhost:5173"
